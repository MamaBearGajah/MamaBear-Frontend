# ─────────────────────────────────────────────────────────────
# MAMABEAR FRONTEND — Environment Variables
# Salin file ini ke .env.local lalu isi nilainya
# cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# ── Backend API (WAJIB) ──────────────────────────────────────
# URL backend NestJS. Jangan tambah trailing slash.
# Local dev  : http://localhost:3000/api
# Production : https://mamabear-backend.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ── Shop Service Account (WAJIB jika MOCK_PRODUCTS=false) ───
# Dipakai server-side untuk SSR catalog (GET /products, /categories).
# Jangan pakai prefix NEXT_PUBLIC_ — ini server-only.
SHOP_SERVER_EMAIL=admin@mamabear.id
SHOP_SERVER_PASSWORD=your_password_here

# ── Payment — Xendit (WAJIB untuk fitur checkout) ───────────
# Secret key dari dashboard Xendit.
# https://dashboard.xendit.co/settings/developers#api-keys
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Mock Data (opsional, default: false) ─────────────────────
# true  = pakai data dummy in-memory, tidak perlu backend jalan
# false = hit NEXT_PUBLIC_API_URL langsung (backend harus jalan)
MOCK_PRODUCTS=false
NEXT_PUBLIC_MOCK_PRODUCTS=false

# ── Site URL (opsional) ──────────────────────────────────────
# Dipakai untuk metadata canonical URL dan Open Graph.
# Local dev  : http://localhost:3001
# Production : https://mama-bear-frontend-mocha.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ── Asset Base URL (opsional) ────────────────────────────────
# Dipakai jika backend return filename saja (bukan full URL) untuk gambar produk.
# Contoh: http://localhost:3000/uploads
# NEXT_PUBLIC_ASSET_BASE_URL=

# ── Sentry (opsional, untuk error tracking) ──────────────────
# Token dari https://sentry.io/settings/account/api/auth-tokens/
# SENTRY_AUTH_TOKEN=