# ─── Backend API (required when mock is off) ───
# Contract base URL: http://localhost:3000/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_API_URL=https://mamabear-backend.onrender.com/api

# ─── Mock data (development only) ───
# true  = use in-memory products/categories/search (no backend needed)
# false = call NEXT_PUBLIC_API_URL (backend must be running + auth below)
MOCK_PRODUCTS=false
NEXT_PUBLIC_MOCK_PRODUCTS=false

# Server-only — shop catalog SSR when visitor has no session cookie.
# BE requires Bearer token for GET /products and GET /categories.
SHOP_SERVER_EMAIL=admin@mamabear.id
SHOP_SERVER_PASSWORD=Admin@12345

# When backend is ready:
# 1. Set NEXT_PUBLIC_API_URL to your API (e.g. http://localhost:3000/api)
# 2. Set MOCK_PRODUCTS=false and NEXT_PUBLIC_MOCK_PRODUCTS=false
# 3. Set SHOP_SERVER_EMAIL / SHOP_SERVER_PASSWORD (server-only, not NEXT_PUBLIC)
# 4. Restart: rm -rf .next && npm run dev

# Optional — base URL for product images when BE returns filenames only
# NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:3000/uploads
# MOCK_ADMIN_AUTH=true
