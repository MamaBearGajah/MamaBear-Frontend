# ─── Backend API (required when mock is off) ───
# Contract base URL: http://localhost:3000/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ─── Mock data (development only) ───
# true  = use in-memory products/categories/search (no backend needed)
# false = call NEXT_PUBLIC_API_URL (backend must be running)
MOCK_PRODUCTS=true
NEXT_PUBLIC_MOCK_PRODUCTS=true

# When backend is ready:
# 1. Set NEXT_PUBLIC_API_URL to your API (e.g. http://localhost:3000/api)
# 2. Set MOCK_PRODUCTS=false and NEXT_PUBLIC_MOCK_PRODUCTS=false
# 3. Restart: rm -rf .next && npm run dev
#
# No code changes required — shop APIs use apiClient + contract paths:
#   GET /products, GET /products/slug/{slug}, GET /search, GET /search/suggestions, GET /categories

# Optional — admin mock login (Sprint 1)
# MOCK_ADMIN_AUTH=true
